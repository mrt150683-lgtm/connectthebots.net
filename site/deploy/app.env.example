# Install at /etc/connectthebots/app.env, root:root, mode 0600.
# Values are literal; shell commands and variable expansion are not supported.
# Leave secrets blank here. app-setup.sh creates SESSION_SECRET on first install.
APP_ENV=production
PUBLIC_BASE_URL=https://connectthebots.net
DATABASE_PATH=/var/lib/connectthebots/app.db
SESSION_SECRET=
# New installations generate this once. Preserve it to read retained backups.
# Existing installations must set/review it explicitly; setup never rotates it.
BACKUP_DIRECTORY=/var/backups/connectthebots
BACKUP_ENCRYPTION_KEY=
# Optional independent B2 recovery. Enroll with the CLI before relying on it.
# Use a private dedicated bucket/prefix and a key limited to bucket listing
# plus file listing/read/write,
# with NO delete or bucket-administration capability. Keep authority objects.
OFFSITE_B2_KEY_ID=
OFFSITE_B2_APPLICATION_KEY=
OFFSITE_B2_BUCKET_ID=
# ctb-<32 random lowercase hex characters>/; never a person or email address.
OFFSITE_B2_PREFIX=
# Required when approving legal pages with offsite backup configured. Supply
# reviewed provider/region/retention/transfer details; it is displayed as text.
OFFSITE_BACKUP_NOTICE=
# Private capability from the reviewed HetrixTools heartbeat monitor.
# Only configured offsite backups with this value use the hourly timer.
BACKUP_HEARTBEAT_URL=
# Private operator mailbox, required before SMTP delivery; never commit a value.
OPERATOR_EMAIL=
# Safe install defaults. SIGNUPS=open is the owner's launch choice, but it does
# not enable sign-in by itself. First configure and review the staging journey.
SIGNUPS=closed
ACCOUNT_SIGNIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable only after the owner approves the exact privacy, terms and contact text.
# This records that approval; it is not permission to deploy to production.
LEGAL_PAGES_APPROVED=false
LEGAL_CONTROLLER_NAME=
# Optional correspondence address; do not insert a personal address by default.
LEGAL_CONTACT_ADDRESS=
CONTACT_EMAIL=
# Publish /.well-known/security.txt only after checking the role mailbox works.
# Set a fixed UTC expiry (YYYY-MM-DDTHH:MM:SSZ), at most 365 days ahead, and
# renew it after reviewing the contact. Blank or stale values yield HTTP 503.
SECURITY_CONTACT_EXPIRES=
VPS_PROVIDER_NAME=
EMAIL_PROVIDER_NAME=
# Reviewed plain-text disclosure of provider measurement and retention; no secrets.
EMAIL_PROCESSING_NOTICE=
# Describe any international transfers, safeguards and how to obtain a copy.
# A no-transfers statement must be checked against the actual providers first.
LEGAL_TRANSFER_DETAILS=
# Development and staging never send mail. Brevo Free was selected; see
# docs/EMAIL_SETUP.md. Provider activation and real delivery remain pending.
# Outbox entries are never delivered, even after switching to SMTP later.
# SMTP needs provider setup and a received-message check before activation.
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Mandatory verified TLS; false is refused when EMAIL_MODE=smtp.
SMTP_STARTTLS=true
