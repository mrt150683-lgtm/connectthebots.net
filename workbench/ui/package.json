{
  "name": "agentmatch-workbench-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Typed browser interface for the fictional AgentMatch local collaboration workbench",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "npm run build && node e2e/journey.mjs",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  }
}
