[Unit]
Description=Connect the Bots hosted application
After=network.target

[Service]
Type=simple
User=ctb
Group=ctb
WorkingDirectory=/var/lib/connectthebots
EnvironmentFile=/etc/connectthebots/app.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/connectthebots/venv/bin/python -m connectthebots_server
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/connectthebots
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
